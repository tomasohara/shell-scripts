# trash_dir=$TMP/"_temp-trash-$(date "+%Y%m%d%H%M%S")"
# command mkdir -p $trash_dir
$ temp_dir=$TMP/alias-trace-misc
$ rename-with-file-date "$temp_dir" > /dev/null
$ command mkdir -p "$temp_dir"
$ command cd $temp_dir

