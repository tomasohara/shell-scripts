# Count aliases w/ -dir in name
# Example:
#   $ alias | egrep '\-dir\b' | wc -l
#   29
$ dir_aliases=$(alias | egrep '\-dir\b' | wc -l)
$ [ "$dir_aliases" -gt 20 ]; echo "$?"
0

## OLD
