## A) gu (grep-unique i-)
# OLD: gu sensitive testgrep1 testgrep2 testgrep3 testgrep4
$ GREP_SENSITIVE_1="$(gu sensitive testgrep1)"
$ GREP_SENSITIVE_2="$(gu sensitive testgrep2)"
$ GREP_SENSITIVE_3="$(gu sensitive testgrep3)"
$ GREP_SENSITIVE_4="$(gu sensitive testgrep4)"
$ [[ $GREP_SENSITIVE_1 == 1 && $GREP_SENSITIVE_2 == 1 && $GREP_SENSITIVE_3 == 0 && $GREP_SENSITIVE_4 == 1 ]]; echo $?
0

## B) gu- (grep-unique)
# OLD: gu- sensitive testgrep1 testgrep2 testgrep3 testgrep4
$ GREP_GU_1="$(gu- sensitive testgrep1)"
$ GREP_GU_2="$(gu- sensitive testgrep2)"
$ GREP_GU_3="$(gu- sensitive testgrep3)"
$ GREP_GU_4="$(gu- sensitive testgrep4)"
$ [[ $GREP_GU_1 == 1 && $GREP_GU_2 == 1 && $GREP_GU_3 == 0 && $GREP_GU_4 == 1 ]]; echo $?
0

# C) grepl- (grep-to-less)
# grepl- "sensitive" testgrep1 testgrep2 testgrep3 testgrep4 | wc -l
$ [ "$(grepl- "sensitive" testgrep1 testgrep2 testgrep3 testgrep4 | wc -l)" -eq 3 ]; echo $?
0

