## command cd $HOME
## [ "$TMP" == /tmp/temp-aliases-test ] && rm -rf "$TMP"
## command cd temp 
## rm -f $(ls | grep tar)

# Make sure GTAR_OPTS set properly
# Setup
# note: regression for subtle make-tar test failures
## DEBUG: GTAR_OPTS="abc"
$ reset-tar-opts
## -or-: unset GTAR_OPTS
$ trace-vars GTAR_OPTS 2>&1

# Verify that the 3 GTAR_OPTS options occurs: "vfz" for verbose, file, and zipped.
# note: the Perl snippet puts each option char on a separate line--sorted for better test reproducibility.
$ option_output="$(echo "$GTAR_OPTS" | perl -pe 's/[a-z]/\n$&/g;' | grep '[a-z]' | sort)"
$ echo "GTAR_OPTS:"
$ echo "$option_output"
$ echo ""
$ option_count="$(echo "$option_output" | grep -c "[fvz]")"
$ [ "$option_count" == "3" ];
$ echo "command_exit_code=$?"
GTAR_OPTS:
f
v
z

command_exit_code=0

# End of test (n.b., avoids extraneous new cells after Kernel > Restart ... Run All Cells)

