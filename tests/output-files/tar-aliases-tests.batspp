# Notebook tests for tar aliases (e.g., sort-tar-archive, tar-this-dir-dated, etc)
# Note: The aliases should be defined before Jupyter is invoked.
# For BatsPP, they can loaded via '--source all-tomohara-aliases-etc.bash' option.
## 13 Sep 26: Fixes to global setup by Gemini and minor tweaks
# Ignoring nitpicking suggestions by shellcheck
#    SC2002: Useless cat. Consider 'cmd < file | ..' or 'cmd file | ..' instead
#    SC2010: Don't use ls | grep. Use a glob or a for loop ...
#    SC2126: Consider using 'grep -c' instead of 'grep|wc -l'.
#    SC2164: Use 'cd ... || exit' or 'cd ... || return' in case cd fails.
# shellcheck disable=SC2002,SC2010,SC2126
## UPDATE 14 Sep 26: Clarifies recent tar tests.

# Global Setup
## Update 13 Jul 26: cleanup for nasty uses of 'rm -r"!
# Warning: (*** never ever use rm -rf "$TMP" (as in earlier version of script)!
# It is very unsafe, even if TMP redefined: the notebook might steps be executed outside of the global context initialization, potentially wiping out /tmp! ***
## TODO1: make pass for other nasty 'rm -r' usages'!
# 
# Prevent 'cd' from echoing absolute paths to stdout (breaks BatsPP strict output matching)
$ export CDPATH=""
# Use cat as pager to prevent headless 'less' from hanging or causing SIGPIPE in CI pipelines
$ export PAGER="cat"
$ TMP=${TMP:-/tmp}
$ temp_dir="$TMP/tar-aliases-tests"
# Explicitly define TEMP so aliases (e.g. recent-tar-this-dir) write to the test dir, not /home/runner/temp
$ export TEMP="$temp_dir/temp"
$ rename-with-file-date "$temp_dir" &> /dev/null
$ command mkdir -p "$temp_dir"
$ command mkdir -p "$TEMP"
$ TAR_BASE="$TEMP"/tarFolder
#
$ mkdir "$temp_dir" --parents
$ command cd "$temp_dir"
$ mkdir tarFolder/first/second/third --parents
$ mkdir tarFolder/temp

# Setup
## DEBUG:
# Show tar-dir aliases
$ show-macros-proper | grep "tar.*dir"

# Setup
# extract-tar tests
# create tar to later extract
#
$ echo "logs" > tarFolder/temp/temp.log
$ TXT=tarFolder/first/second/third/tar.txt
$ echo "tar this" > "$TXT"
$ tar -zcvf tared.tar.gz tarFolder > /dev/null
$ rename-with-file-date tarFolder &> /dev/null

# extract the tar just created
$ extract-tar tared.tar.gz > /dev/null

# Assert the files are extracted
$ [ "$(ls | grep Folder | wc -l)" -eq 1 ]; echo $?;
1

#extract-tar-force tests
$ echo "tar this 2" >> "$TXT"
$ prev_lines=$(cat "$TXT" | wc -l )
$ extract-tar-force tared.tar.gz > /dev/null

#Assert amount of lines after and before extract-force
$ [ "$prev_lines" -eq 2 ] && [ "$(cat "$TXT" | wc -l)" -eq 1 ]; echo $?;
0

# un-tar tests
# same as extract-tar
$ rename-with-file-date tarFolder &> /dev/null
$ un-tar tared.tar.gz > /dev/null

# Assert the files are extracted
$ [ "$(ls | grep tarFolder | wc -l)" -eq 1 ]; echo $?;
1

#extract-tar-here tests
$ mkdir testFolder
$ command cd "$temp_dir"/testFolder
$ extract-tar-here tared.tar.gz > /dev/null

# Assert the files are extracted
$ command cd "$TMP"
$ [ "$(ls | grep testFolder | wc -l)" -eq 1 ]; echo $?;
1

# view-tar tests
# Assert the existence of five dirs inside tar
$ tared=$(view-tar tared.tar.gz | wc -l)
$ [ "$tared" -eq 7 ]; echo $?;
1

# make-tar tests
# test with no optional args
$ make-tar test tarFolder > /dev/null
$ test=$(view-tar test.tar.gz | wc -l)

# assert lines_test should be equal to lines_tared
$ [ "$tared" -eq "$test" ]; echo $?
1

$ rm -f test.tar.gz
# make-tar with arguments ignores empty dirs
$ make-tar test tarFolder 5 > /dev/null
$ test=$(view-tar test.tar.gz | wc -l)
removed 'test.tar.gz'

# assert theres only one line
$ [ "$test" -eq 2 ]; echo $?
1

#if no optional arguments are given
# make-tar skips filtering and a few other steps, 
# so it should execute less commands overall
$ filtered=$(trace-cmd make-tar test dir 5 | wc -l) 
$ unfiltered=$(trace-cmd make-tar test dir | wc -l) 

$ [ "$filtered" -gt "$unfiltered" ]; echo $?;
0

## TEMP
# Setup
$ pwd

# tar-dir tests
## TODO2: stay within /tmp
$ command cd "$HOME"
$ tar-dir "$temp_dir/tarFolder" > /dev/null

# lines_tar_dir should also be equal to lines_tared, but since it uses 
# make-tar it probably shouldn't
$ tar_dir=$(view-tar "$TEMP/tarFolder.tar.gz" | wc -l)
$ [ "$tared" -eq "$tar_dir" ]; echo $?;
1

# tar-just-dir tests
# tar-just-dir tars the given dir with specified depth of 1
$ tar-just-dir "$temp_dir"/tarFolder/first/second/third > /dev/null
$ tar-just-dir "$temp_dir"/tarFolder > /dev/null
$ not_empty=$(view-tar "$temp_dir"/temp/third.tar.gz | wc -l)
$ empty=$(view-tar "$TAR_BASE.tar.gz" | wc -l)

#assert lines_empty equals 0 and lines_not_empty is not (should equals 1)
$ [ "$not_empty" -gt "$empty" ] && [ "$empty" -eq 0 ]; echo $?;
0

# tar-this-dir tests
$ command cd "$temp_dir"/tarFolder
$ tar-this-dir > /dev/null
$ this_dir=$(view-tar "$TAR_BASE.tar.gz" | wc -l )

# assert the .tar includes all subdirs and files in tarFolder
$ [ "$this_dir" -eq 7 ]; echo $?;
1

# new-tar-this-dir tests
# NOTE: THIS PRODUCES A TAR FILE WITHOUT NAME
## OLD: rm -f "$temp_dir"/tarFolder.tar.gz
$ rename-with-file-date "$temp_dir"/tarFolder.tar.gz &> /dev/null
$ new-tar-this-dir > /dev/null
$ new_this_dir=$(view-tar "$temp_dir"/temp/tarFolder.tar.gz | wc -l)

#assert new-tar-this-dir produced the tar with the correct name and files inside
$ [ "$new_this_dir" -eq 7 ]; echo $?;
1

# tar-this-dir-dated tests
$ tar-this-dir-dated > /dev/null
$ this_dir_dated=$(view-tar "$TAR_BASE-$(TODAY)".tar.gz | wc -l )

#assert tar-this-dir-dated 
$ [ "$this_dir_dated" -eq "$this_dir" ]; echo $?;
0

## OLD: 
$ rm -f "$TAR_BASE-$(TODAY)".tar.gz
## NOTE: The following produced stderr output (":1"), which abouts the script due to jupyter quirk.
## TODO3: rename-with-file-date "$TAR_BASE-$(TODAY)".tar.gz &> /dev/null
removed '/home/ai-user/temp/tmp/tar-aliases-tests/temp/tarFolder-14sep26.tar.gz'

## OLD:
## # tar-this-dir-normal tests
## # normal excludes temp, backup and archive folders
## 
## #DOESN'T WORK BECAUSE DEFINITION OF TAR-DIR IS WRONG
##
## tar-this-dir-normal > /dev/null
## this_dir_normal=$(view-tar "$TAR_BASE".tar.gz | wc -l )
##
## [ "$this_dir_normal" -eq 1 ]; echo $?

# tar-this-dir-pruned tests
# pruned excludes temp, backup and archive folders
$ tar-this-dir-pruned > /dev/null
$ this_dir_pruned=$(view-tar "$TAR_BASE".tar.gz | wc -l )

$ [ "$this_dir_pruned" -eq 1 ]; echo $?
0

# tar-just-this-dir tests
# since tarFolder just contains folders, and tarFolder/temp contains one file,
# tarFolder_plain = 0 and tarFolder_temp = 1 should be true
$ command cd "$temp_dir"/tarFolder
$ tar-just-this-dir > /dev/null
$ tarFolder_plain=$(view-tar "$temp_dir"/temp/tarFolder.tar.gz | wc -l)
$ command cd temp
$ tar-just-this-dir > /dev/null
$ tarFolder_temp=$(view-tar "$temp_dir"/temp/temp.tar.gz | wc -l)

# assert the results are correct
$ [ "$tarFolder_plain" -eq 0 ] && [ "$tarFolder_temp" -eq 1 ]; echo $?;
0

# tar-just-this-dir-dated tests
# should produce same results as not dated version
$ command cd "$temp_dir"/tarFolder
$ tar-just-this-dir-dated > /dev/null
$ tarFolder_plain_dated=$(view-tar "$temp_dir/temp/tarFolder-$(TODAY).tar.gz" | wc -l)
$ command cd temp
$ tar-just-this-dir-dated > /dev/null
$ tarFolder_temp_dated=$(view-tar "$temp_dir/temp/temp-$(TODAY).tar.gz" | wc -l)

# assert the results are consistent with the non-dated version
$ [ "$tarFolder_plain_dated" -eq "$tarFolder_plain" ] && [ "$tarFolder_temp_dated" -eq "$tarFolder_temp" ]; echo $?; 
0

# make-recent-tar tests
# note: `make-recent-tar - 0` is for files that have been just created, otherwise 
# it specifies less than how many days old the files can be, ignoring folders.
# Setup
$ command cd "$temp_dir"/tarFolder
$ make-recent-tar test.tar.gz 1 > /dev/null
$ echo "test.tar.gz:"
$ view-tar test.tar.gz
$ recent_tar_count=$(view-tar test.tar.gz | wc -l)
$ echo "find ... -mtime -1:"
$ find . -type f -mtime -1

# assert make-recent-tar takes expected files
$ expected_count=$(find . -type f -mtime -1 | wc -l)
$ trace-vars recent_tar_count expected_count 2>&1
$ [ "$recent_tar_count" -eq "$expected_count" ]; echo $?;
recent_tar_count=2; expected_count=3; 
1

# recent-tar-this-dir tests
# note: should make the same result as make-recent-tar
# Setup
# make-recent-tar now includes .tar.gz in the file name
## OLD: rm -f test.tar.gz
$ recent-tar-this-dir 1 > /dev/null
$ echo "$TEMP/recent-tarFolder.tar.gz:"
$ view-tar "$TEMP/recent-tarFolder.tar.gz"
$ recent_tar_this_count=$(view-tar "$TEMP/recent-tarFolder.tar.gz" | wc -l)
$ echo "find ... -mtime -1:"
$ find . -type f -mtime -1

# check that there are expected number of files created recently
$ expected_count=$(find . -type f -mtime -1 | wc -l)
$ trace-vars recent_tar_this_count expected_count 2>&1
$ [ "$recent_tar_this_count" -eq "$expected_count" ]; echo $?;
recent_tar_this_count=0; expected_count=3; 
1

