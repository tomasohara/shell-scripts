## echo "<b>Dog</b>, not a cat." | displayHTML
## echo "alert('It is known khaleesi\!');" | displayJS

## DEBUG
##
## Note: that aliases and function definitions are not taken from the terminal,
## but, environment variables are.
##
## TEST: 
## - via Bash:
##   export MY_VAR=123; alias my-alias='echo hey;'; function my-function { echo joe; }
##   run-jupyter-notebook
## via http://localhost:8888:
##    echo $MY_VAR;  alias my-alias;  typeset -f | grep my-function

## DEBUG
# perl -version
$ [ -n "$(perl -version | grep -e "perl 5" -e "subversion [N]")" ]; echo $?
0

## DEBUG
# perl.sh -version
$ [ -n "$(perl.sh -version | grep -e "perl 5" -e "subversion [N]" -e "Larry Wall")" ]; echo $?
0

## DEBUG
# bash ../perl.sh -version
## OLD: [ -n "$(bash ../perl.sh -version | grep -e "perl 5" -e "version [N]" -e "perl.org")" ]; echo $?
$ [ -n "$(bash perl.sh -version | grep -e "perl 5" -e "version [N]" -e "perl.org")" ]; echo $?
0

$ [ "$(perl -version)" = "$(perl.sh -version)" ]; echo $?
0

## DEBUG
# which bash
$ [ "$(which bash)" = "/usr/bin/bash" ]; echo $?
0

## DEBUG
# which env
$ [ "$(which env)" = "/usr/bin/env" ]; echo $?
0

## DEBUG
$ [[ "$(echo $PATH)" =~ [^:]+(:[^:]+)* ]]; echo $?
0

## DEBUG
## NOTE: disables pager byredirection
$ PAGER=show-path 2>&1 | cat
$ [ $PAGER = "less" ]; echo $?
0

# Make sure perl.sh invokes perl properly
$ perl_version=$(perl -version 2>&1 | extract-matches "\(v(\S+)\)")
$ perl_sh_version=$(perl.sh -version 2>&1 | extract-matches "\(v(\S+)\)")
# eval-not-equals "$perl_version" "" 
# eval-equals "$perl_version" "$perl_sh_version" 
$ [[ "$(eval-not-equals "$perl_version" "")" = "True" && "$(eval-equals "$perl_version" "$perl_sh_version")" = "True" ]]; echo $?
0

# eval-equals "$perl_version" "$perl_sh_version" 
$ [[ "$perl_help" == "$perl_sh_help" && "$(eval-equals "$perl_version" "$perl_sh_version")" = "True" ]]; echo $?
0

