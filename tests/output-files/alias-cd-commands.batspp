$ expected="USER_PATH/temp/tmp/alias-cd-commands"
$ cd-this-realdir "$temp_dir" >/dev/null
$ actual2=$(command pwd | testuserpath)
$ [[ "$actual1" = "$expected" && "$actual2" = "$expected" ]]; echo $?
