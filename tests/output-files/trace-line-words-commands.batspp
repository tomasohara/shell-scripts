# Global Setup
$ alias testuser="sed -r "s/"$USER"+/userxf333/g""
# alias testnum="sed -r "s/[0-9]/N/g""  
## For number of digits not being critical
$ alias testnum="sed -r "s/[0-9][0-9]*/N/g""

# Count aliases proper
$ alias | wc -l | testnum
N

# Count functions
$ typeset -f | egrep '^\w+' | wc -l | testnum
N

