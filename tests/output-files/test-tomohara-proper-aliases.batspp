# Resolving deltas: 100% (14/14), done.
# Script done.
# FYI: script-based clone done (see _clone-git-sandbox-26feb25.log)

# Setup
$ command cd "$temp_dir"
$ git-clone-alias https://github.com/tomasohara/git-sandbox > "_clone.log" 2>&1

$ [[ -e "$temp_dir"/git-sandbox/LICENSE ]]; echo $?
0

$ extract-matches "remote: (Compressing|Counting|Enumerating|Total)" "$temp_dir"/_clone-git-sandbox-$(T).log | sort -u
Compressing
Counting
Enumerating
Total

# Setup
## TODO3: Add '# Cleanup' to [simple_]batspp.py comment-indicator flags
$ command cd "$test_dir"

