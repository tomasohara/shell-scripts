$ run-python-script
Usage: [ENV-OPTIONS] run-python-script script arg ...
   ENV-OPTIONS: [USE_STDIN=B] [USE_STDOUT=B] [PROFILE_SCRIPT=B] [TRACE_SCRIPT=B] [PYTHON_DEBUG_LEVEL=n] [PYTHON_OUT_DIR=p] [KEEP_EMPTY_OUT=b] [PYTHON=path] [PYTHON_RUN_LABEL=str]
note:
- PYTHON_DEBUG_LEVEL uses 4 by default (unless regular DEBUG_LEVEL)
- PYTHON_OUT_DIR is script dir unless a full path

$ trace-vars _PSL_ 2>&1
_PSL_=; 

$ [ "$_PSL_" == "" ]; echo $?
0

# Setup
$ log_file="$temp_dir/run-python-script.log"
$ PYTHON_DEBUG_LEVEL=0 run-python-script template.py --help > "$log_file"

## OLD: grep -A1 '==>' "$log_file"
## OLD: grep -A1 '==>' "$log_file" | timestamp-as-today
$ grep '==>' "$log_file" | timestamp-as-today | perl -pe 's/\e\[[0-9;]*[A-Za-z]//g; s@^==> TEMP_DIR/(?:test-tomohara-proper-aliases/)?(_template\\.today\\.run)(?:\\.[0-9]+\\.(?:log|out) <==)?$@==> TEMP_DIR/$1@;'
==> TEMP_DIR/_template.today.run.1.log <==
==> TEMP_DIR/_template.today.run.1.out <==

$ trace-vars _PSL_ 2>&1
_PSL_=1; 

$ [ "$_PSL_" == "1" ]; echo $?
0

## Sample ouput of run-python-script with "==>"
## ==> /home/tomohara/temp/tmp/test-tomohara-proper-aliases/_template.13jul26.run
## /home/tomohara/Mezcla/mezcla/template.py --help
## --
## ==> /home/tomohara/temp/tmp/test-tomohara-proper-aliases/_template.13jul26.run
##  filename    Input filename

# note: Run again to ensure counter used in filename updated 
$ PYTHON_DEBUG_LEVEL=0 run-python-script template.py --help >| "$log_file"
## OLD: grep -A1 '==>' "$log_file"
## OLD: grep -A1 '==>' "$log_file" | timestamp-as-today
$ grep '==>' "$log_file" | timestamp-as-today | perl -pe 's/\e\[[0-9;]*[A-Za-z]//g; s@^==> TEMP_DIR/(?:test-tomohara-proper-aliases/)?(_template\\.today\\.run)(?:\\.[0-9]+\\.(?:log|out) <==)?$@==> TEMP_DIR/$1@;'
==> TEMP_DIR/_template.today.run.2.log <==
==> TEMP_DIR/_template.today.run.2.out <==

$ trace-vars _PSL_ 2>&1
_PSL_=2; 

$ [ "$_PSL_" == "2" ]; echo $?
0

$ run-python-script-reset 2>&1
_PSL_=0; 

$ [ "$_PSL_" == "0" ]; echo $?
0

#-------------------------------------------------------------------------------
# test-python-script
#
# Sample output:
#
# $ PYTEST_DEBUG_LEVEL=0 test-python-script test_jupyter_to_batspp.py
# ==> ./_test_jupyter_to_batspp.25feb25.15.log <==
# /usr/local/misc/programs/anaconda3/envs/nlp-py-3-11/bin/pytest -vv --capture=tee-sys test
# 
# ==> ./_test_jupyter_to_batspp.25feb25.15.out <==
# cachedir: .pytest_cache
# hypothesis profile 'default' -> database=DirectoryBasedExampleDatabase(PosixPath('/tpo/mi
# rootdir: /tpo/misc/programs/bash/shell-scripts-devel/tests
# plugins: hypothesis-6.97.0, devtools-0.12.2, anyio-3.7.1
# collecting ... collected 2 items
#
# test_jupyter_to_batspp.py::TestIt::test_data_file XFAIL                             [ 50%
# test_jupyter_to_batspp.py::TestIt::test_valid_notebook XPASS                        [100%
#
# ============================== 1 xfailed, 1 xpassed in 0.35s ============================

# Setup
$ log_file="$temp_dir/test-python-script.log"
$ PYTEST_DEBUG_LEVEL=0 test-python-script tests/test_jupyter_to_batspp.py > "$log_file" 2>&1

## current output
## tests/test_jupyter_to_batspp.py::TestIt::test_data_file
## tests/test_jupyter_to_batspp.py::TestIt::test_valid_notebook
$ extract-matches '^\S+::TestIt::\S+' "$log_file" | perl -pe 's@^tests/@@'
test_jupyter_to_batspp.py::TestIt::test_data_file
test_jupyter_to_batspp.py::TestIt::test_valid_notebook

## current output (for "...=== 2 xpassed in 0.40s ====...")
## 1
$ egrep -c '(failed|passed).* in' "$log_file"
1

#-------------------------------------------------------------------------------
