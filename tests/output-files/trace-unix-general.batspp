# ps_sort.perl -by=mem -

# Make sure -once runs once without looping
$ timeout 5s ps_sort.perl -once - | perl -lne 'print 1 and exit if /^USER/'
1

# Make sure -mem sorts processes by memory descending
$ timeout 5s ps_sort.perl -once -mem - | perl -lane 'push @m, $F[3] if $.==2 || $.==3; END { print ($m[0] >= $m[1] ? 1 : 0); }'
1

# Make sure -alpha sorts lexicographically (PID 1 appears first)
$ timeout 5s ps_sort.perl -once -alpha -by=pid - | perl -lane 'print $F[1] if $. == 2'
1

# Make sure environment variables do not override defaults for no-env switches
$ mem=1 alpha=1 timeout 5s ps_sort.perl -once -by=pid - | perl -lane 'print ($F[1] > 1 ? 1 : 0) if $. == 2'
1

