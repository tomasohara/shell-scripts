## Need a filter to sensor day and month
## bash-trace-on ENABLES bash tracing
$ bash-trace-on | testuser | testnum
## trace-cmd TRACES COMMANDS AND STATS (TIME) OF THE USER
$ trace-cmd | testuser | testnum
## MOVED: NEXT CELL
# ## bash-trace-on DISABLES bash tracing
# bash-trace-off | testuser | testnum
# trace-cmd | testuser | testnum
start: Mon Oct N N:N:N AM EDT N
++ is-true EVAL_COMMAND
++ local env_name=EVAL_COMMAND
++ local value
+++ eval echo '${EVAL_COMMAND:-false}'
++++ echo false
++ value=false
+++ echo false
+++ tr '[:upper:]' '[:lower:]'
++ value=false
++ local result=true
++ case "$value" in
++ result=false
++ echo false
+ local EVAL_COMMAND=false
+ [[ false != true ]]
++ alias ''
+ [[ '' != '' ]]
+ false
+ set +o xtrace
end: Mon Oct N N:N:N AM EDT N

## bash-trace-on DISABLES bash tracing
$ bash-trace-off | testuser | testnum
$ trace-cmd | testuser | testnum
start: Mon Oct N N:N:N AM EDT N
++ is-true EVAL_COMMAND
++ local env_name=EVAL_COMMAND
++ local value
+++ eval echo '${EVAL_COMMAND:-false}'
++++ echo false
++ value=false
+++ echo false
+++ tr '[:upper:]' '[:lower:]'
++ value=false
++ local result=true
++ case "$value" in
++ result=false
++ echo false
+ local EVAL_COMMAND=false
+ [[ false != true ]]
++ alias ''
+ [[ '' != '' ]]
+ false
+ set +o xtrace
end: Mon Oct N N:N:N AM EDT N

