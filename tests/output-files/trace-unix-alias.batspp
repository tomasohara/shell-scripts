#
# Count non-ascii (excludes newline)
# via ascii manpage:  Oct   Dec   Hex   Char ... 040   32    20    SPACE ... 176   126   7E    ~
$ non_ascii_count=$(echo -n "$PS1" | grep -v -c '[ - ~]')
$ [ "$non_ascii_count" -eq 0 ]; echo $?
1

