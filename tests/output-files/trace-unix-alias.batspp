userxf333 pts/N - N:N N:N N.Ns ? 
tomohara ttyN - NOctN Ndays N:Nm N.Ns 
userxf333 pts/N - NOctN Ndays N:N ? 
userxf333 pts/N - NOctN Ndays N.Ns ? 
userxf333 pts/N - NOctN N:Nm N.Ns ? 
       

