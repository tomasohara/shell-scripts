# Global Setup
## TODO2: rename testuser, testnum, etc. to encode-user, encode-num, etc.
$ alias testuser="sed -r "s/"$USER"+/userxf333/g""
$ alias testnum="sed -r "s/[0-9][0-9]*/N/g""
$ alias testalpha='sed -r "s/[A-Za-z]/A/g"'
$ alias linebr="printf '%132s\n' ' ' | tr ' ' '-'"
$ alias encode-month='perl -pe "s/\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\b/month/ig;"'
$ alias encode-weekday='perl -pe "s/\b(sun|mon|tue|wed|thur|fri|sat)\b/weekday/ig;"'

