## NOTE: Need a filter to sensor day and month
## bash-trace-on ENABLES bash tracing
## OLD: bash-trace-on | testuser | testnum
#
# example:
# $ cond-export ENV4 value4
# + conditional-export ENV4 value4
# ...
# ++ printenv ENV4
# + '[' '' == '' ']'
# + export ENV4=value4
# ...
$ unset ENV1 ENV2
$ bash-trace-on
$ cond-export ENV1 value1 2>&1 | grep ENV1.*value1
# note: makes sure 4+ references
$ c=$(cond-export ENV2 value2 2>&1 | grep -c ENV2.*value2)
$ bash-trace-off
$ [ $c -ge 4 ]; echo $?
+ grep --color=auto 'ENV1.*value1'
+ conditional-export ENV1 value1
+ export [01;31m[KENV1=value1[m[K
+ [01;31m[KENV1=value1[m[K
+ args='[01;31m[KENV1 value1[m[K'
+ '[' '[01;31m[KENV1 value1[m[K' = '' ']'
++ conditional-export ENV2 value2
++ grep --color=auto -c 'ENV2.*value2'
+ c=4
+ set +o xtrace
0

# test trace-cmd TRACES COMMANDS AND STATS (TIME) OF THE USER
## BAD: trace-cmd | testuser | testnum
$ unset ENV3 ENV4
$ echo "w/ trace"
# note: makes sure 4+ references
$ c=$(trace-cmd cond-export ENV3 value3 | grep -c ENV3.*value3)
$ [ $c -ge 4 ]; echo $?
# note: makes sure no references
$ echo "w/o trace"
$ c=$(cond-export ENV4 value4 | grep -c ENV4.*value4)
$ [ $c -eq 0 ]; echo $?
w/ trace
0
w/o trace
0

## MOVED: NEXT CELL
# ## bash-trace-on DISABLES bash tracing
# bash-trace-off | testuser | testnum
