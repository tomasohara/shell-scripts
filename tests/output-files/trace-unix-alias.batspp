# test bash-trace-off which DISABLES bash tracing
#
# example w/ tracing:
# $ bash-trace-off
# + set +o xtrace
$ bash-trace-on
$ c=$(bash-trace-off | grep -c xtrace)
$ [ $c -eq 1 ]; echo $?
$ bash-trace-off
++ set +o xtrace
++ grep --color=auto -c xtrace
+ c=0
+ '[' 0 -eq 1 ']'
+ echo 1
1
+ set +o xtrace

